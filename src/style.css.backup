*{box-sizing:border-box}
body{margin:0;background:#05070c;color:#eef2ff;font-family:Inter,system-ui,-apple-system,sans-serif}
.os{max-width:1550px;margin:auto;padding:26px}
header{height:70px;border-bottom:1px solid #1d2635;display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:12px}.hermes{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,#756cff,#9e7cff);font-size:23px;font-weight:900;box-shadow:0 0 30px #7168ff55}
.brand b{display:block;font-size:18px;letter-spacing:3px}.brand span{font-size:9px;color:#6d7890;letter-spacing:2px}
.system{font-size:10px;color:#73e6a2;letter-spacing:1px}.system i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#63e69b;box-shadow:0 0 12px #63e69b;margin-right:7px}
.top{display:flex;justify-content:space-between;align-items:center;padding:48px 0 32px}.eyebrow{font-size:10px;letter-spacing:3px;color:#707c96}.top h1{font-size:48px;margin:10px 0}.top em{font-style:normal;color:#8276ff}.top p{color:#768299;font-size:16px}.clock{border:1px solid #273148;border-radius:16px;padding:18px 28px;text-align:center;color:#727e95;font-size:9px;letter-spacing:2px}.clock strong{color:#62e59b}
.metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.metric{background:#0b1019;border:1px solid #1b2535;border-radius:14px;padding:19px}.metric small{display:block;color:#667289;font-size:9px;letter-spacing:1px}.metric strong{display:block;font-size:27px;margin:8px 0}.metric span{font-size:10px;color:#63e69b}
.workspace{margin-top:28px;background:#080d15;border:1px solid #1d2839;border-radius:18px;overflow:hidden}.workspaceHead{padding:20px 25px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #1b2636}.workspaceHead h2{margin:5px 0;font-size:21px}.pulse{font-size:9px;color:#61e69c;letter-spacing:2px}
.world{height:520px;position:relative;overflow:hidden;background:radial-gradient(circle at center,#131b2b,#070b12 65%);background-image:linear-gradient(#101826 1px,transparent 1px),linear-gradient(90deg,#101826 1px,transparent 1px);background-size:50px 50px}
.hermesStation{position:absolute;left:50%;top:42%;transform:translate(-50%,-50%);width:150px;text-align:center;padding:15px;border:1px solid #695eff66;border-radius:16px;background:#0d1220;box-shadow:0 0 60px #665dff20;z-index:5}.robot{font-size:38px;animation:float 2s infinite ease-in-out}.hermesStation strong{display:block;letter-spacing:2px}.hermesStation small{color:#8178ff;font-size:8px}.screen{margin-top:10px;border:1px solid #25324a;padding:7px;color:#62e69b;font-size:8px;letter-spacing:1px}
.agent{position:absolute;width:135px;padding:10px;text-align:center;background:#0b111b;border:1px solid #1d293b;border-radius:13px;z-index:4;animation:agentPulse 2s infinite}.agentIcon{font-size:25px}.agent strong{display:block;font-size:11px;margin-top:3px}.agent small{font-size:7px;color:#62e69b;letter-spacing:1px}.desk{height:32px;margin:7px auto 2px;width:65px;position:relative}.monitor{position:absolute;width:36px;height:23px;left:15px;background:#172338;border:2px solid #35435c;border-radius:3px}.keyboard{position:absolute;width:42px;height:5px;bottom:0;left:11px;background:#29354a;border-radius:4px}.task{font-size:7px;color:#64728a}
.agent0{left:7%;top:15%}.agent1{left:27%;top:10%}.agent2{right:27%;top:10%}.agent3{right:7%;top:15%}.agent4{left:10%;bottom:12%}.agent5{left:31%;bottom:8%}.agent6{right:30%;bottom:8%}.agent7{right:10%;bottom:12%}
.leadStream{position:absolute;left:0;top:0;height:100%;width:95px;padding:20px 10px;color:#66758e;font-size:8px;text-align:center}.particles span{display:block;color:#6f7cff;font-size:13px;margin:28px 0;animation:travel 2.5s infinite}.particles span:nth-child(2){animation-delay:.4s}.particles span:nth-child(3){animation-delay:.8s}.particles span:nth-child(4){animation-delay:1.2s}.particles span:nth-child(5){animation-delay:1.6s}.particles span:nth-child(6){animation-delay:2s}
.moneyStream{position:absolute;right:20px;top:47%;color:#65728a;font-size:8px;letter-spacing:1px;text-align:center}.moneyStream strong{display:block;color:#70e7a0;font-size:14px;margin:10px}.moneyStream small{font-size:7px}
.bottom{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:14px;margin-top:15px}.panel{background:#0b1019;border:1px solid #1b2635;border-radius:14px;padding:20px;min-height:230px}.panelTitle{font-size:9px;letter-spacing:2px;color:#68758c;margin-bottom:16px}.activity{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid #141e2b;font-size:11px}.activity small{margin-left:auto;color:#59667c;font-size:8px}.green{color:#61e69b}.empty{color:#59667c;font-size:11px}
.funnel{margin:13px 0}.funnel>div:first-child{display:flex;justify-content:space-between;font-size:9px;color:#78859a}.bar{height:5px;background:#141d2b;border-radius:5px;margin-top:5px;overflow:hidden}.bar i{display:block;height:100%;background:linear-gradient(90deg,#5e6fff,#62e69b);border-radius:5px}
.queue{display:flex;gap:9px;align-items:center;border-bottom:1px solid #141e2b;padding:10px 0}.queue div{flex:1}.queue b,.queue small{display:block}.queue b{font-size:10px}.queue small{color:#626f85;font-size:8px;margin-top:3px}.queue em{font-style:normal;font-size:7px;color:#62e69b}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}@keyframes agentPulse{0%,100%{box-shadow:0 0 0 transparent}50%{box-shadow:0 0 25px #6875ff18}}@keyframes travel{0%{transform:translateX(-20px);opacity:0}30%{opacity:1}100%{transform:translateX(100px);opacity:0}}
@media(max-width:1000px){.metrics{grid-template-columns:repeat(2,1fr)}.bottom{grid-template-columns:1fr}.world{height:700px}.agent{transform:scale(.8)}.top h1{font-size:36px}}
