PORT=4010
APP_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/hermes

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=generate-a-long-random-string

STRIPE_MODE=live
STRIPE_SECRET_KEY=sk_live_...
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloud LLMs only. Do not run Ollama on this machine.
# SpaceXAI first if the key is valid (https://console.x.ai).
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Free / no-card extras — paste any of these. AGENT007 failovers across them.
# Groq (US, fastest free): https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (aggregator, many countries): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Cerebras (US, fast Llama): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Mistral (France): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# DeepSeek (China): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY==
# Together: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY==
# NVIDIA NIM: https://build.nvidia.com
NVIDIA_API_KEY==

# Any other country's OpenAI-compatible API:
# OPENAI_COMPAT_BASE_URL=https://api.example.com/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=their-model-name

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
HERMES_REQUIRE_APPROVAL=true
